#!/usr/bin/env python3
"""Synchronize locally installed Steam games into Sunshine apps.json.

Only Steam game entries generated by this script are changed. User-managed entries
(Desktop and Steam Gaming, plus any future custom entries) are preserved.
Sunshine is restarted only when no Sunshine TCP connection or gamescope process is
active; otherwise a pending marker is left for the next timer/path run.
"""

import json
import os
import re
import subprocess
import sys
from pathlib import Path

# systemctl --user needs the user session bus even when invoked from a bare
# shell (cron/ssh/agent) that has none. Default to the conventional paths;
# setdefault is a no-op when the caller already provides them.
os.environ.setdefault("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
os.environ.setdefault("DBUS_SESSION_BUS_ADDRESS",
                      "unix:path=" + os.environ["XDG_RUNTIME_DIR"] + "/bus")

HOME = Path.home()
APPS_PATH = HOME / ".config/sunshine/apps.json"
STEAM_ROOT = HOME / ".steam/debian-installation"
STEAMAPPS = STEAM_ROOT / "steamapps"
STEAM_LIBRARY_CACHE = STEAM_ROOT / "appcache/librarycache"
SUNSHINE_ASSETS = HOME / ".config/sunshine/assets"
LAUNCHER = str(HOME / ".local/bin/moonlight-steam")
STATE_DIR = HOME / ".local/state/sunshine-steam-sync"
PENDING_RESTART = STATE_DIR / "pending-sunshine-restart"
AUTO_COMMAND = re.compile(r"^" + re.escape(LAUNCHER) + r" --app-id ([0-9]+)$")

# Installed Steam tooling/runtimes are not playable Library entries.
EXCLUDED_APP_IDS = {"1070560", "1493710", "4183110"}
EXCLUDED_NAMES = {"Proton Experimental", "Steam Linux Runtime 1.0 (scout)", "Steam Linux Runtime 4.0"}

# Name patterns catching runtime/tool families whose app IDs keep changing
# (Proton 8.0/9.0/10.0, Proton Hotfix, SLR soldier/sniper/medic, ...).
# Anchored and version-qualified so real games with similar prefixes
# (e.g. "Protons for Science") are not excluded.
EXCLUDED_NAME_PATTERNS = [
    re.compile(r"^Steam Linux Runtime \d"),
    re.compile(r"^Proton (\d|Experimental$|Hotfix|EasyAntiCheat)"),
    re.compile(r"^Steamworks (Common Redistributables|SDK)"),
]

# Preferred Steam library art assets for Sunshine (vert/portrait grid image).
# Older clients cache header.jpg under the appid root; newer clients nest them
# under a hash subdirectory. The first found image is used.
PREFERRED_IMAGE_FILES = [
    "library_600x900.jpg",
    "library_capsule.jpg",
    "header.jpg",
    "library_header.jpg",
]
CANDIDATE_IMAGE_SUFFIXES = (".jpg", ".jpeg", ".png")


def vdf_field(text: str, key: str) -> str | None:
    match = re.search(rf'"{re.escape(key)}"\s+"([^"]*)"', text)
    return match.group(1) if match else None


def steam_library_roots() -> list[Path]:
    roots = [STEAM_ROOT]
    libraryfolders = STEAMAPPS / "libraryfolders.vdf"
    if libraryfolders.exists():
        text = libraryfolders.read_text(errors="replace")
        for raw_path in re.findall(r'"path"\s+"([^"]+)"', text):
            path = Path(raw_path.replace("\\\\", "/"))
            if path not in roots:
                roots.append(path)
    return roots


def installed_games() -> list[tuple[str, str, Path | None]]:
    games: dict[str, tuple[str, Path | None]] = {}
    for root in steam_library_roots():
        for manifest in (root / "steamapps").glob("appmanifest_*.acf"):
            text = manifest.read_text(errors="replace")
            app_id = vdf_field(text, "appid")
            name = vdf_field(text, "name")
            install_dir = vdf_field(text, "installdir")
            if not app_id or not name or not install_dir:
                continue
            if (app_id in EXCLUDED_APP_IDS or name in EXCLUDED_NAMES
                    or any(p.search(name) for p in EXCLUDED_NAME_PATTERNS)):
                print(f"Excluding Steam tool/runtime from Library: {name} ({app_id})")
                continue
            if not (root / "steamapps/common" / install_dir).is_dir():
                continue
            games[app_id] = (name, find_steam_library_image(app_id))
    return sorted(games.items(), key=lambda game: game[1][0].casefold())


def find_steam_library_image(app_id: str) -> Path | None:
    """Locate a usable Steam library cache image for the given app ID."""
    base = STEAM_LIBRARY_CACHE / app_id
    if not base.is_dir():
        return None

    for preferred in PREFERRED_IMAGE_FILES:
        # Look in the appid root and one level of hash subdirectories.
        for candidate in [base / preferred] + list((base).glob(f"*/{preferred}")):
            if candidate.is_file() and candidate.stat().st_size > 0:
                return candidate

    # Last resort: any image in the appid directory that looks like a cache asset.
    for pattern in ("*.jpg", "*.jpeg", "*.png"):
        for candidate in base.rglob(pattern):
            if candidate.is_file() and candidate.stat().st_size > 0:
                return candidate
    return None


def copy_game_image(app_id: str, source: Path | None) -> str:
    """Return the Sunshine image-path string for this game, copying the asset if available.

    Sunshine's appasset endpoint only serves PNG files from a configured assets directory.
    Older releases (2025.x) often resolve relative image-path values against
    /usr/share/sunshine/web/assets. To be robust across both possibilities we:
      1) copy/convert the chosen Steam cache asset into ~/.config/sunshine/assets, and
      2) also mirror it into /usr/share/sunshine/web/assets if we have write access.
    The returned path is an absolute path so /appasset can serve it regardless of the
    release's relative-path resolution rules.
    """
    if source is None:
        return "steam.png"

    try:
        import shutil
        import subprocess

        SUNSHINE_ASSETS.mkdir(parents=True, exist_ok=True)
        user_dest = SUNSHINE_ASSETS / f"steam_{app_id}.png"

        # Prefer ImageMagick convert; fallback to ffmpeg.
        if shutil.which("convert"):
            subprocess.run(
                ["convert", str(source), str(user_dest)],
                check=True,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
        elif shutil.which("ffmpeg"):
            subprocess.run(
                [
                    "ffmpeg",
                    "-y",
                    "-i", str(source),
                    "-vf", "format=pix_fmts=rgba",
                    "-frames:v", "1",
                    str(user_dest),
                ],
                check=True,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
        else:
            raise RuntimeError("no JPEG-to-PNG converter available")

        # Mirror to the web assets dir if writable (common path for Sunshine 2025.x).
        web_assets = Path("/usr/share/sunshine/web/assets")
        if web_assets.is_dir() and os.access(web_assets, os.W_OK):
            try:
                web_dest = web_assets / f"steam_{app_id}.png"
                shutil.copy2(user_dest, web_dest)
            except Exception as exc:
                print(f"WARNING: could not mirror asset for {app_id} into web assets: {exc}", file=sys.stderr)

        return str(user_dest)
    except Exception as exc:
        print(f"WARNING: could not convert/copy asset for {app_id}: {exc}", file=sys.stderr)
        return "steam.png"


def is_safe_to_restart() -> bool:
    # A gamescope process means a Steam Gaming session is active or winding down.
    if subprocess.run(["pgrep", "-u", str(os.getuid()), "-x", "gamescope"],
                      stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0:
        return False

    # Any established Sunshine service-port connection is conservatively treated as
    # active. This also defers a restart during Web UI access rather than risking it.
    result = subprocess.run(
        ["ss", "-Htn", "state", "established"],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    return not any(re.search(r":(47984|47989|47990|48010)\b", line) for line in result.stdout.splitlines())


def restart_sunshine_when_safe() -> bool:
    if not is_safe_to_restart():
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        PENDING_RESTART.touch()
        print("Sunshine Library updated; restart deferred because a stream/gamescope session is active.")
        return False

    subprocess.run(["systemctl", "--user", "restart", "sunshine.service"], check=True)
    PENDING_RESTART.unlink(missing_ok=True)
    print("Sunshine restarted to load synchronized Library entries.")
    return True


def main() -> int:
    if not APPS_PATH.exists():
        print(f"ERROR: Sunshine apps file not found: {APPS_PATH}", file=sys.stderr)
        return 1

    try:
        current = json.loads(APPS_PATH.read_text())
    except json.JSONDecodeError as exc:
        print(f"ERROR: invalid JSON in {APPS_PATH}: {exc}", file=sys.stderr)
        return 1

    apps = current.get("apps")
    if not isinstance(apps, list):
        print("ERROR: apps.json does not contain an apps array", file=sys.stderr)
        return 1

    # Retain user-managed applications; replace only auto-generated Steam entries.
    retained = []
    for app in apps:
        command = app.get("cmd") if isinstance(app, dict) else None
        if isinstance(command, str) and AUTO_COMMAND.fullmatch(command):
            continue
        retained.append(app)

    auto_apps = [
        {
            "name": name,
            "cmd": f"{LAUNCHER} --app-id {app_id}",
            "image-path": copy_game_image(app_id, image),
        }
        for app_id, (name, image) in installed_games()
    ]
    desired = dict(current)
    desired["apps"] = retained + auto_apps
    desired_text = json.dumps(desired, ensure_ascii=False, indent=2) + "\n"
    current_text = APPS_PATH.read_text()

    changed = desired_text != current_text
    if changed:
        temporary = APPS_PATH.with_suffix(".json.tmp")
        temporary.write_text(desired_text)
        os.replace(temporary, APPS_PATH)
        print(f"Synchronized {len(auto_apps)} installed Steam game(s) into Sunshine Library.")
        restart_sunshine_when_safe()
    elif PENDING_RESTART.exists():
        print("No Library changes; retrying deferred Sunshine restart.")
        restart_sunshine_when_safe()
    else:
        print(f"Sunshine Library already matches {len(auto_apps)} installed Steam game(s).")

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
